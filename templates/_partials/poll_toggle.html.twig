{% trans_default_domain 'EasyAdminMessengerManager' %}
<button type="button" class="eamm-poll-toggle" data-eamm-poll-toggle
        data-eamm-label-pause="{{ 'eamm.poll.pause'|trans({'%seconds%': seconds}) }}" data-eamm-label-resume="{{ 'eamm.poll.resume'|trans }}"
        aria-label="{{ 'eamm.poll.pause'|trans({'%seconds%': seconds}) }}" title="{{ 'eamm.poll.pause'|trans({'%seconds%': seconds}) }}"><span class="eamm-live-dot" aria-hidden="true"></span></button>
