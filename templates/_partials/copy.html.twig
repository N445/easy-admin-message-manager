{% trans_default_domain 'EasyAdminMessengerManager' %}
<button type="button" class="eamm-copy" data-eamm-copy="{{ text }}" data-eamm-copied-label="{{ 'eamm.copy.copied'|trans }}"
        aria-label="{{ 'eamm.copy.label'|trans({'%value%': label ?? text}) }}" title="{{ 'eamm.copy.label'|trans({'%value%': label ?? text}) }}"><i class="fa-regular fa-copy" aria-hidden="true"></i></button>
