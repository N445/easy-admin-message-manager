{% extends '@EasyAdmin/page/content.html.twig' %}
{% trans_default_domain 'EasyAdminMessengerManager' %}

{% block content_title %}{{ block('eamm_title') }}{% endblock %}

{% block head_javascript %}
    {{ parent() }}
    <script src="{{ asset('bundles/easyadminmessengermanager/eamm.js') }}" defer></script>
{% endblock %}

{% block head_stylesheets %}
    {{ parent() }}
    <style>
        .eamm { --eamm-surface: var(--content-bg); --eamm-surface-alt: var(--body-bg); --eamm-border: var(--border-color); --eamm-text: var(--text-color); --eamm-muted: var(--text-muted); --eamm-accent: var(--ea-primary); --eamm-danger: var(--color-danger); --eamm-success: var(--color-success); --eamm-warning: var(--color-warning); color: var(--eamm-text); }
        .ea-dark-scheme .eamm { --eamm-muted: var(--gray-400); }
        .eamm-tabs { display: flex; flex-wrap: wrap; gap: .25rem; border-bottom: 1px solid var(--eamm-border); margin-bottom: 1.25rem; padding: 0; list-style: none; }
        .eamm-tabs a { display: block; padding: .5rem .9rem; color: var(--eamm-muted); border-bottom: 2px solid transparent; margin-bottom: -1px; text-decoration: none; }
        .eamm-tabs a:hover { color: var(--eamm-text); }
        .eamm-tabs a[aria-current="page"] { color: var(--eamm-accent); border-bottom-color: var(--eamm-accent); font-weight: 600; }
        .eamm-pills { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: 1rem; }
        .eamm-pill { background: var(--eamm-surface); color: var(--eamm-text); border: 1px solid var(--eamm-border); border-radius: var(--border-radius-pill, 999px); padding: .25rem .75rem; font-size: var(--font-size-sm, 13px); cursor: pointer; }
        .eamm-pill:hover { border-color: var(--eamm-accent); }
        .eamm-pill[aria-pressed="true"] { border-color: var(--eamm-accent); background: var(--ea-primary-subtle, var(--eamm-surface)); color: var(--eamm-accent); font-weight: 600; }
        .eamm-pill.is-failure .eamm-pill-count { color: var(--eamm-danger); }
        .eamm-pill-count { color: var(--eamm-muted); margin-left: .25rem; font-variant-numeric: tabular-nums; }
        .eamm-section-title { font-size: var(--font-size-lg, 16px); font-weight: 600; margin: 1.5rem 0 .75rem; display: flex; align-items: center; gap: .5rem; }
        .eamm-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: .75rem; margin-bottom: 1.5rem; }
        .eamm-card { background: var(--eamm-surface); border: 1px solid var(--eamm-border); border-radius: var(--border-radius, 6px); padding: .75rem 1rem; box-shadow: var(--shadow-md, none); }
        .eamm-card-failure { border-color: var(--eamm-danger); }
        .eamm-card-name { color: var(--eamm-muted); font-size: .85em; display: flex; justify-content: space-between; gap: .5rem; }
        .eamm-card-value { font-size: 1.6rem; font-weight: 600; line-height: 1.3; color: var(--eamm-text); font-variant-numeric: tabular-nums; }
        .eamm-card-failure .eamm-card-value { color: var(--eamm-danger); }
        .eamm-card a { font-size: .85em; color: var(--link-color); text-decoration: none; }
        .eamm-card-stuck { border-color: var(--eamm-warning); }
        .eamm-card-age { font-size: .85em; color: var(--eamm-muted); }
        .eamm-card-age.is-stuck { color: var(--eamm-warning); font-weight: 600; }
        .eamm-card-link { display: block; color: inherit; text-decoration: none; }
        .eamm-card-link:hover, .eamm-card-link:focus-visible { border-color: var(--eamm-accent); color: inherit; }
        .eamm-trend { font-size: 1rem; margin-left: .25rem; vertical-align: middle; }
        .eamm-trend.is-up { color: var(--eamm-warning); }
        .eamm-trend.is-down { color: var(--eamm-success); }
        .eamm-see-all { display: inline-block; margin-top: .35rem; font-size: .85em; color: var(--link-color); }
        .eamm-muted { color: var(--eamm-muted); font-size: .85em; }
        .eamm-error { color: var(--eamm-danger); font-size: .85em; }
        .eamm-mono { font-family: var(--font-family-monospace, monospace); font-size: .85em; overflow-wrap: anywhere; }
        .eamm-clamp { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; overflow-wrap: anywhere; }
        .eamm-trace { max-height: 480px; overflow: auto; font-size: .8em; white-space: pre-wrap; overflow-wrap: anywhere; background: var(--eamm-surface-alt); color: var(--eamm-text); border: 1px solid var(--eamm-border); border-radius: var(--border-radius, 6px); padding: .75rem; }
        .eamm-panel { background: var(--eamm-surface); border: 1px solid var(--eamm-border); border-radius: var(--border-radius, 6px); padding: .75rem 1rem; }
        .eamm-filters { display: flex; flex-wrap: wrap; gap: .75rem; align-items: flex-end; margin-bottom: 1rem; }
        .eamm-filters label { display: block; font-size: .8em; color: var(--eamm-muted); margin-bottom: .2rem; }
        .eamm-input { background: var(--form-control-bg); color: var(--eamm-text); border: 1px solid var(--form-input-border-color, var(--eamm-border)); border-radius: var(--border-radius, 6px); padding: .3rem .5rem; min-width: 170px; font-size: var(--font-size-sm, 13px); }
        .eamm-input:focus { outline: 2px solid var(--ea-primary-ring, var(--eamm-accent)); outline-offset: 0; }
        .eamm-table-wrap { overflow-x: auto; margin-bottom: 1rem; }
        .eamm-table-wrap > .table { margin-bottom: 0; }
        .eamm-breakdown { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
        .eamm-breakdown table { margin: 0; }
        .eamm-toolbar { display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; margin: .75rem 0; padding: .5rem .75rem; background: var(--eamm-surface); border: 1px solid var(--eamm-border); border-radius: var(--border-radius, 6px); }
        .eamm-toolbar-sep { width: 1px; align-self: stretch; background: var(--eamm-border); margin: 0 .25rem; }
        .eamm-notice { position: sticky; top: 0; z-index: 5; display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; border: 1px solid var(--bs-alert-border-color); border-radius: var(--border-radius, 6px); padding: .6rem .9rem; margin-bottom: 1rem; }
        .eamm-notice-close { background: none; border: 0; padding: 0 .25rem; color: inherit; font-size: 1.25rem; line-height: 1; cursor: pointer; opacity: .75; }
        .eamm-notice-close:hover, .eamm-notice-close:focus-visible { opacity: 1; }
        .eamm-pagination { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .5rem; margin-top: .75rem; }
        .eamm-pagination-links { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem; }
        .eamm-pagination .btn[aria-current] { border-color: var(--eamm-accent); color: var(--eamm-accent); opacity: 1; }
        .eamm-pagination-gap { padding: 0 .25rem; color: var(--eamm-muted); }
        .eamm-pagination-jump { display: flex; align-items: center; gap: .35rem; margin: 0 0 0 .5rem; font-size: .85em; color: var(--eamm-muted); }
        .eamm-pagination-jump .eamm-input { min-width: 0; width: 5.5rem; }
        .eamm-link-button { background: none; border: 0; padding: 0; color: var(--link-color); cursor: pointer; font-size: .9em; }
        .eamm-link-button.is-danger { color: var(--eamm-danger); }
        .eamm-link-button:disabled { opacity: .5; cursor: default; }
        .eamm-copy { background: none; border: 0; padding: 0 .25rem; color: var(--eamm-muted); cursor: pointer; }
        .eamm-copy:hover, .eamm-copy:focus-visible { color: var(--eamm-accent); }
        .eamm-copy.is-copied { color: var(--eamm-success); }
        .eamm-poll-toggle { background: none; border: 0; padding: .25rem; line-height: 0; cursor: pointer; }
        .eamm-live-dot { width: .5rem; height: .5rem; border-radius: 50%; background: var(--eamm-success); display: inline-block; }
        .eamm-poll-toggle.is-paused .eamm-live-dot { background: var(--eamm-muted); }
        .eamm-chips { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; margin-bottom: 1rem; }
        .eamm-chip { display: inline-flex; align-items: center; gap: .35rem; background: var(--eamm-surface); border: 1px solid var(--eamm-border); border-radius: var(--border-radius-pill, 999px); padding: .15rem .25rem .15rem .7rem; font-size: var(--font-size-sm, 13px); }
        .eamm-chip .eamm-muted { font-size: inherit; }
        .eamm-chip-remove { background: none; border: 0; padding: 0 .35rem; color: var(--eamm-muted); font-size: 1.1rem; line-height: 1; cursor: pointer; }
        .eamm-chip-remove:hover, .eamm-chip-remove:focus-visible { color: var(--eamm-danger); }
        .eamm-presets { display: flex; flex-wrap: wrap; gap: .25rem; }
        .eamm-sort { background: none; border: 0; padding: 0; color: inherit; font: inherit; cursor: pointer; white-space: nowrap; }
        .eamm-sort:hover, .eamm-sort:focus-visible { color: var(--eamm-accent); }
        .eamm-breakdown-panel > summary, .eamm-section > summary { cursor: pointer; font-weight: 600; margin: 1rem 0 .75rem; }
        .eamm-section > summary { font-size: var(--font-size-lg, 16px); margin-top: 1.5rem; }
        .eamm-frame { font-weight: normal; font-size: var(--font-size-sm, 13px); margin-left: .5rem; }
        .eamm-similar { margin-left: .5rem; font-family: var(--font-family-base, inherit); font-size: .9em; }
        .eamm-error-message { white-space: pre-wrap; overflow-wrap: anywhere; }
        .eamm-is-loading { opacity: .5; pointer-events: none; transition: opacity .15s; }
        .eamm-json { margin-bottom: 1.5rem; }
        .eamm-json-toolbar { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin-bottom: .5rem; }
        .eamm-json-toolbar .eamm-input.is-not-found { border-color: var(--eamm-danger); }
        .eamm json-viewer {
            display: block; max-height: 600px; overflow: auto; padding: .75rem;
            border: 1px solid var(--eamm-border); border-radius: var(--border-radius, 6px);
            --background-color: var(--eamm-surface-alt);
            --color: var(--eamm-text);
            --font-family: var(--font-family-monospace, monospace);
            --font-size: var(--font-size-sm, 13px);
            --line-height: 1.5;
            --indent-size: 1em;
            --indentguide-color: var(--eamm-border);
            --indentguide-color-active: var(--eamm-muted);
            --outline-color: var(--eamm-accent);
            --property-color: var(--ea-primary-text, var(--eamm-accent));
            --string-color: var(--eamm-success);
            --number-color: var(--eamm-warning);
            --boolean-color: var(--link-color);
            --null-color: var(--eamm-muted);
            --preview-color: var(--eamm-muted);
            --highlight-color: var(--eamm-danger);
        }
        @media (max-width: 767.98px) {
            .eamm-col-optional { display: none; }
        }
        @media (max-width: 575.98px) {
            .eamm-filters > * { flex: 1 1 100%; }
            .eamm-filters .eamm-input { width: 100%; min-width: 0; }
        }
    </style>
{% endblock %}

{% block main %}
    <div class="eamm">
        <div class="alert alert-warning eamm-notice" role="alert" data-eamm-setup-alert="live" hidden>{{ 'eamm.setup.live_missing'|trans }}</div>
        <div class="alert alert-warning eamm-notice" role="alert" data-eamm-setup-alert="assets" hidden>{{ 'eamm.setup.assets_missing'|trans }}</div>
        {% set eamm_tabs = {overview: 'eamm.tab.overview', messages: 'eamm.tab.messages', failed: 'eamm.tab.failed'}|merge(eamm_history_enabled ? {history: 'eamm.tab.history'} : {}) %}
        <ul class="eamm-tabs">
            {% for action, label in eamm_tabs %}
                <li>
                    <a href="{{ ea_url().unsetAll().setController(eamm_controller).setAction(action) }}" {% if app.request.attributes.get('crudAction') == action %}aria-current="page"{% endif %}>{{ label|trans }}</a>
                </li>
            {% endfor %}
        </ul>
        {% block eamm_content %}{% endblock %}
    </div>
{% endblock %}
