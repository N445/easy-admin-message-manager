{% extends '@EasyAdminMessengerManager/layout.html.twig' %}
{% trans_default_domain 'EasyAdminMessengerManager' %}

{% block eamm_title %}{{ label }} <span class="eamm-muted">#{{ view.id }}</span>{% endblock %}

{% block head_javascript %}
    {{ parent() }}
    <script src="{{ asset('bundles/easyadminmessengermanager/vendor/json-viewer/json-viewer.bundle.js') }}" defer></script>
    <script src="{{ asset('bundles/easyadminmessengermanager/eamm-json.js') }}" defer></script>
{% endblock %}

{% block eamm_content %}
    {% if is_failure %}
        {{ component('EAMM:MessageActions', {
            controller: eamm_controller,
            dashboard: eamm_dashboard,
            transport: view.transport,
            messageId: view.id,
            decodable: view.decodable,
        }) }}
    {% else %}
        <div class="d-flex gap-2 mb-3">
            <a class="btn btn-sm btn-secondary" href="{{ ea_url().setController(eamm_controller).setAction('messages').set('transport', view.transport) }}">← {{ view.transport }}</a>
        </div>
    {% endif %}

    {% if not view.decodable %}
        <div class="eamm-notice eamm-notice-warning">{{ 'eamm.failed.undecodable_help'|trans }}</div>
    {% endif %}

    <table class="table datagrid">
        <tbody>
            <tr><th>{{ 'eamm.column.class'|trans }}</th><td class="eamm-mono">{{ view.messageClass }}</td></tr>
            <tr><th>{{ 'eamm.column.transport'|trans }}</th><td>{{ view.transport }}</td></tr>
            <tr><th>{{ 'eamm.column.origin'|trans }}</th><td>{{ view.originalTransport ?? '—' }}</td></tr>
            <tr><th>{{ 'eamm.column.retries'|trans }}</th><td>{{ view.retryCount }}</td></tr>
            <tr><th>{{ 'eamm.column.failed_at'|trans }}</th><td>{{ view.failedAt ? view.failedAt|date('Y-m-d H:i:s') : '—' }}</td></tr>
            <tr><th>{{ 'eamm.column.exception'|trans }}</th><td class="eamm-mono">{{ view.exceptionClass ?? '—' }}</td></tr>
            <tr><th>{{ 'eamm.column.error'|trans }}</th><td>{{ view.exceptionMessage ?? '—' }}</td></tr>
        </tbody>
    </table>

    {% if view.flattenException %}
        <h2 class="eamm-section-title">{{ 'eamm.show.trace'|trans }}</h2>
        {% for exception in [view.flattenException]|merge(view.flattenException.allPrevious) %}
            <details {{ loop.first ? 'open' }} class="mb-2">
                <summary class="eamm-mono">{{ exception.class }}: {{ exception.message }}</summary>
                <pre class="eamm-trace">{{ exception.traceAsString }}</pre>
            </details>
        {% endfor %}
    {% endif %}

    <h2 class="eamm-section-title">{{ 'eamm.show.payload'|trans }}</h2>
    {% include '@EasyAdminMessengerManager/_partials/json_viewer.html.twig' with {json: payload} %}

    <h2 class="eamm-section-title">{{ 'eamm.show.stamps'|trans }}</h2>
    {% include '@EasyAdminMessengerManager/_partials/json_viewer.html.twig' with {json: stamps, expand: ''} %}
{% endblock %}
